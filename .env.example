# Muse's keys. Copy this file to .env and paste your keys after the "=":
#
#     cp .env.example .env
#
# .env stays on your computer (it is in .gitignore). The companion server reads
# it, and `python3 companion/deploy_modal.py` hands the keys to your online server.

# Voice chat: https://console.deepgram.com  (see "Setting up Deepgram" in the README)
DEEPGRAM_API_KEY=

# Background jobs, such as research: https://console.anthropic.com  (optional)
ANTHROPIC_API_KEY=
