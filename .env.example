# Muse's keys. Copy this file to .env and paste your keys after the "=":
#
#     cp .env.example .env
#
# .env stays on your computer (it is in .gitignore). The companion server reads
# it, and `python3 companion/deploy_modal.py` hands the keys to your online server.

# Voice chat: https://console.deepgram.com  (see "Setting up Deepgram" in the README)
DEEPGRAM_API_KEY=

# Background jobs, such as research: https://console.anthropic.com  (optional)
ANTHROPIC_API_KEY=

# Online server only: the password for it. Muse, the Claude Code hooks and the
# web app's sign-in all use it. Leave it empty and deploy_modal.py makes a random
# one and writes it here. To choose your own, use at least 16 characters without
# spaces; after changing it, deploy again and pair Muse again
# (python3 companion/muse_companion.py pair), and sign in again in the web app.
MUSE_TOKEN=

# Online server only: "true" lets anyone who has the server's address read the
# results page without the token. Muse's own connection and the Claude Code
# hooks always need the token.
# MUSE_RESULTS_PUBLIC=true
