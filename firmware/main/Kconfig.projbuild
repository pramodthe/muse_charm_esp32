menu "Muse charm"

    config MUSE_BRIGHTNESS
        int "Display brightness (%)"
        range 10 100
        default 80

    menu "Sound"
        config MUSE_SOUND_ENABLE
            bool "Play chirps on the speaker"
            default y

        config MUSE_SPEAKER_VOLUME
            int "Speaker volume (%)"
            range 0 100
            default 65
            help
                Applies to the chirps and to Muse's spoken replies.
    endmenu

    menu "Voice"
        config MUSE_VOICE_ENABLE
            bool "React to voice on the microphone"
            default y
            help
                Without voice chat, Muse looks up and moves its mouth with your
                voice. Off while voice chat is set up.

        config MUSE_MIC_GAIN_DB
            int "Microphone gain (dB)"
            range 0 42
            default 30

        config MUSE_VOICE_RATIO_X10
            int "Voice threshold above room noise (x10)"
            depends on MUSE_VOICE_ENABLE
            range 12 100
            default 28
            help
                How much louder than the learned room noise a sound must be to
                count as voice. 28 means 2.8 times (about 9 dB). Lower it if
                Muse ignores you, raise it if Muse reacts to background noise.
    endmenu

    menu "Motion"
        config MUSE_MOTION_ENABLE
            bool "Tilt and shake with the QMI8658 motion sensor"
            default y

        config MUSE_LEAN_INVERT
            bool "Invert the lean direction"
            depends on MUSE_MOTION_ENABLE
            default n
            help
                Muse leans against the tilt to stay upright. Turn this on if it
                leans the wrong way on your board.

        config MUSE_TILT_ENTER_DEG
            int "Tilt needed to start leaning (degrees)"
            depends on MUSE_MOTION_ENABLE
            range 2 30
            default 7

        config MUSE_SHAKE_THRESHOLD_X10
            int "Shake threshold (m/s^2 x10)"
            depends on MUSE_MOTION_ENABLE
            range 30 300
            default 80
    endmenu

    menu "Voice chat (Deepgram)"
        config MUSE_AGENT_ENABLE
            bool "Talk to Muse through the Deepgram Voice Agent API"
            default y
            help
                Hold the screen to talk; Muse answers out loud. Needs WiFi and a
                Deepgram API key, both entered on the setup page (hold the BOOT
                button for 3 seconds, then join the "Muse-setup" WiFi).

        config MUSE_AGENT_DEFAULT_VOICE
            string "Default voice"
            default "aura-2-thalia-en"
            help
                A Deepgram Aura voice. The setup page can change it.

        config MUSE_AGENT_LISTEN_MODEL
            string "Speech-to-text model"
            default "nova-3"

        config MUSE_AGENT_THINK_PROVIDER
            string "LLM provider"
            default "open_ai"
            help
                Deepgram think provider type, for example open_ai, anthropic or google.

        config MUSE_AGENT_THINK_MODEL
            string "LLM model"
            default "gpt-4o-mini"

        config MUSE_AGENT_PROMPT
            string "Default personality"
            default "You are Muse, a tiny cheerful companion who lives inside a little screen. You are warm, playful and curious, and you talk like a kind friend. Everything you say is spoken aloud, so keep each reply to one or two short sentences and never use lists, markdown, emojis or stage directions. When it fits, call muse_action to wave, giggle, cheer or act dizzy."
            help
                The setup page can replace it.

        config MUSE_AGENT_IDLE_CLOSE_S
            int "Close the connection after this many quiet seconds"
            range 10 3600
            default 120
    endmenu

    menu "Claude Code companion"
        config MUSE_COMPANION_ENABLE
            bool "Show what Claude Code is doing on your computer"
            default y
            help
                Run companion/muse_companion.py on the computer and add the
                Claude Code hooks with companion/install_hooks.py. Muse finds
                the server on the local network by itself.

        config MUSE_COMPANION_URL
            string "Server address (empty: find it automatically)"
            depends on MUSE_COMPANION_ENABLE
            default ""
            help
                Only needed on networks that block broadcasts, for example
                ws://192.168.1.20:8765/device

        config MUSE_COMPANION_SOUNDS
            bool "Chirp when Claude finishes or needs you"
            depends on MUSE_COMPANION_ENABLE
            default y
    endmenu

    config MUSE_DEBUG_LOG
        bool "Log microphone and motion readings"
        default n
        help
            Prints the microphone level and accelerometer readings every few
            seconds, useful for tuning the thresholds above.

endmenu
